# ========================================================
# Welfare Management System - Backend Environment Config
# ========================================================

# Server Port (Render sets this dynamically via $PORT)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# Frontend Origin URL(s) for CORS allowlisting
# In production, set this to your Vercel deployment URL(s).
# Multiple URLs can be separated by commas (e.g. https://app.vercel.app,https://customdomain.com)
CLIENT_URL=https://your-welfare-app.vercel.app

# JWT Secret Key for signing authentication tokens
# In production, replace with a strong, 64-character random string
JWT_SECRET=production_jwt_secret_key_change_me_to_a_secure_random_string_2026

# Token expiration duration (e.g. '24h', '7d')
JWT_EXPIRES_IN=24h

# Neon PostgreSQL Database Connection URL
# Obtain this from your Neon Console (https://console.neon.tech/)
# Connection Details -> Pooled Connection String (with ?sslmode=require)
DATABASE_URL=postgresql://[user]:[password]@[ep-xyz.region.neon.tech]/[dbname]?sslmode=require
