{
  "name": "nextjs-express-workspace",
  "version": "1.0.0",
  "description": "Clean Next.js frontend with Express.js backend from scratch",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "verify": "node backend/scripts/validate-deployment-configs.js",
    "verify:db": "node backend/scripts/test-neon-accessibility.js"
  },
  "keywords": [
    "nextjs",
    "express",
    "clean-architecture",
    "fullstack"
  ],
  "license": "ISC"
}
